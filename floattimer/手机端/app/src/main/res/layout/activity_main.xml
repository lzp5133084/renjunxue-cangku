<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题与作者信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="军哥懂保 · 悬浮计时器"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="v1.0.7 · 作者：军哥懂保（微信：xunijiayuan）"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="当前时间 --:--:--"
            android:textColor="@color/indigo"
            android:textSize="13sp" />

        <!-- 推广有惊喜按钮 -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_gradient"
            android:text="🎁 推广有惊喜 · 大使招募"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 悬浮窗权限提示条 -->
        <LinearLayout
            android:id="@+id/layoutPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="悬浮球需要「悬浮窗权限」才能显示在其他应用上方"
                android:textColor="#fbbf24"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGoPermission"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_gradient"
                android:text="去开启悬浮窗权限"
                android:textColor="#ffffff"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 大时间显示 -->
        <TextView
            android:id="@+id/tvBigTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="00:00"
            android:textColor="@color/text_primary"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum" />

        <!-- 模式切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_mode_selected"
                android:text="正计时"
                android:textColor="#ffffff"
                android:textSize="15sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnModeDown"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_mode_unselected"
                android:text="倒计时"
                android:textColor="#ffffff"
                android:textSize="14sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnModePomodoro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_mode_unselected"
                android:text="🍅 番茄钟"
                android:textColor="#ffffff"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 番茄钟阶段标签：专注/休息 与轮次 -->
        <TextView
            android:id="@+id/tvPhaseLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="🍅 专注中 · 第 1 轮"
            android:textColor="@color/indigo"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 倒计时预设 -->
        <LinearLayout
            android:id="@+id/layoutPresets"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPreset1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="1分钟"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnPreset5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="5分钟"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnPreset10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="10分钟"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnPreset25"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="25分钟"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 自定义时长 + 结束前提醒 -->
        <Button
            android:id="@+id/btnCustomTime"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="⚙ 自定义时长（时:分:秒）"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 番茄钟参数设置 -->
        <Button
            android:id="@+id/btnPomodoroSetting"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="⚙ 番茄设置（专注 25 / 休息 5 分钟）"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 控制按钮 -->
        <Button
            android:id="@+id/btnStartPause"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_gradient"
            android:text="▶ 开始"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="⏹ 停止"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="↺ 重置"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnSaveRecord"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="✎ 命名保存"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="📋 计次"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="↻ 重复上次"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Space android:layout_width="8dp" android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnFloatToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="开启悬浮球"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 计次记录：正计时/番茄钟运行中分段计时 -->
        <LinearLayout
            android:id="@+id/layoutLaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 计次记录"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearLaps"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="清空"
                    android:textColor="#f87171"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLapList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- 正计时到时提醒设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 到时提醒"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editAlertMinutes"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_edit"
                android:gravity="center"
                android:hint="分钟"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="#5a5a78"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="分钟后响铃提醒（正计时）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 倒计时结束前语音提醒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 结束前提醒"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editPreAlertSec"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_edit"
                android:gravity="center"
                android:hint="秒"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="#5a5a78"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="秒时语音播报（倒计时）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPreAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 命名保存开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="计时结束后提醒我命名保存（关闭则按当前时间自动保存）"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAskName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 使用记录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="使用记录"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearRecords"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="清空"
                android:textColor="#f87171"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="暂无记录\n完成一次计时后可命名保存，记录会显示在这里"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="使用说明：开启悬浮球后，桌面会出现圆形计时球，可随意拖动；\n单击回到本界面，双击开始/停止计时，长按弹出功能菜单（含重复计时）。\n「停止」会结束本次计时并可命名保存；「重置」仅清零不保存。\n「番茄钟」专注结束自动进入休息，休息结束自动开始下一轮，时长可自定义。\n「计次」在正计时/番茄钟运行中记录分段用时；「重复上次」一键复用上次模式与时长。\n记录条目点「改名」可重命名，长按可删除。"
            android:textColor="#5a5a78"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
